/**
 * Chip PC (Program Counter)
 */

CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
	Register(in=outMux, load=true, out=out, out=outReg) // Registro
	
	Inc16(in=outReg, out=outRegInc); // Incrementador de 16 bits
	
	MUX8WAY16(a=outReg, b=outRegInc, c=in, d=in, e=false, f=false, g=false, h=false, sel[2]=reset, sel[1]=load, sel[0]=inc, out=outMux); // Multiplexor de 8 entradas de 16 bits
}