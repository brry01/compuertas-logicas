/**
 * Memoria de 16K registros de 16 bits
 */

CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
	DEMUX4WAY(in=load, sel=address[12..13], a=load0, b=load1, c=load2, d=load3); // Demultiplexor de 4 entradas
	
	// 4 Chips RAM4K de 16 bits
	RAM4K(in=in, load=load0, address=address[0..11], out=out0);
	RAM4K(in=in, load=load1, address=address[0..11], out=out1);
	RAM4K(in=in, load=load2, address=address[0..11], out=out2);
	RAM4K(in=in, load=load3, address=address[0..11], out=out3);
	
	MUX4WAY16(a=out0, b=out1, c=out2, d=out3, sel=address[12..13], out=out); // Multiplexor de 4 entradas de 16 bits
}